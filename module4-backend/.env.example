PORT=5004
NODE_ENV=development
CORS_ORIGIN=*

# Oracle (oracledb thin mode - no Oracle Client needed for Oracle DB 12.1+)
DB_USER=certapp
DB_PASSWORD=change_me
DB_CONNECT_STRING=localhost:1521/XEPDB1

# MUST be the same secret Module 2 (Authentication) uses to sign JWTs
JWT_SECRET=same_secret_as_auth_module
# Roles as stored in your USERS table / JWT payload
ADMIN_ROLE=ADMIN
ISSUER_ROLE=ISSUER

# Blockchain (Module 1) integration: none | http
#  none -> only DB hash is compared
#  http -> GET {BLOCKCHAIN_API_URL}/certificates/{id}  -> { "hash": "<sha256>" }
BLOCKCHAIN_MODE=none
BLOCKCHAIN_API_URL=http://localhost:5001/api/blockchain
BLOCKCHAIN_TIMEOUT_MS=5000

# Internal key so other modules can call POST /api/notifications/internal/send
INTERNAL_API_KEY=change_this_key

# Optional email (leave SMTP_HOST empty to disable emails, in-app notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Certificate Verifier <no-reply@example.com>"

# Public verify rate limit (per IP per minute)
VERIFY_RATE_LIMIT=60
