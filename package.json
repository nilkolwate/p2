{
  "name": "blockvault",
  "version": "2.0.0",
  "description": "BlockVault — Blockchain-Based Certificate Verification System",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix blockvault-frontend",
    "start": "npm-run-all --parallel start:backend start:frontend",
    "dev:backend": "npm start --prefix backend",
    "dev:frontend": "npm start --prefix blockvault-frontend",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm start --prefix blockvault-frontend"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
